# Copy to .env.local. Everything is optional: the app runs fully local without any of these.

# Google AdSense publisher id, e.g. ca-pub-1234567890123456. Ads render only when set,
# and only on content pages (landing, project hub, dashboard), never in the lesson workspace.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Supabase project "pockett" (accounts + cloud progress). Both values are public by design.
# Used for sign-in and progress sync.
NEXT_PUBLIC_SUPABASE_URL=https://irrzwowbetnyppvxflvi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_WVNVR1HBlLSqBOX-q54bhw_aYWni4Mt

# Code runner for compiled languages (C#, C++, Go): Vercel Sandbox microVMs created from a toolchain
# snapshot (see docs/ARCHITECTURE.md, "Languages"). Server-side only; the browser never sees these.
# There are no long-lived secrets: the Sandbox SDK authenticates with the Vercel OIDC token every
# deployment gets automatically (locally: `vercel link && vercel env pull .env.local`).
#
# Id of the snapshot to start every run from. Produced by POST /api/run/setup or
# `node scripts/runner/build-snapshot.mjs`. Leave empty and /api/run answers 503, and those courses
# show as "coming soon".
RUNNER_SNAPSHOT_ID=
# Bearer token for POST /api/run/setup (building the snapshot). Leave unset to disable that route (404).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUNNER_ADMIN_TOKEN=
# Optional tuning:
#   RUNNER_MODE=fresh        "fresh" (default: a new microVM per run) or "pool" (reuse warm microVMs)
#   RUNNER_POOL_SIZE=3       warm microVMs per server instance in pool mode
#   RUNNER_VCPUS=2           vCPUs per sandbox (2 GB RAM each)
#   RUNNER_RATE_PER_MIN=30   runs per IP per minute, per server instance
#   RUNNER_MAX_CONCURRENCY=8 simultaneous runs per server instance
#   RUNNER_BASE_IMAGE=vercel/sandbox/ubuntu:latest   base image used when building the snapshot
#
# Cost controls (see docs/ARCHITECTURE.md, "Cost controls"):
#   RUNNER_DISABLED=1               kill switch: /api/run answers 503 and creates no sandbox at all.
#                                   Redeploy after setting it; remove it (and redeploy) to turn the runner back on.
#   RUNNER_MAX_CREATES_PER_MIN=120  sandbox creations per minute per server instance, all users combined
#   RUNNER_KEEP_SNAPSHOT_IDS=       extra snapshot ids (comma separated) the setup clean-up must never delete
#
# Bearer secret for the stale-sandbox sweeper, GET /api/run/sweep (a Vercel Cron job in vercel.json runs it every
# 10 minutes). Vercel sends it as "Authorization: Bearer $CRON_SECRET" automatically once the variable exists.
# Leave unset and the route answers 404 (the cron then does nothing). Generate one like RUNNER_ADMIN_TOKEN.
CRON_SECRET=
