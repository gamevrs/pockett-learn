<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links: www.pockett.ai serves /.well-known/apple-app-site-association (src/lib/app-links.ts).
	     Only www: the apex redirects to www, and Apple does not follow redirects for the association file. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.pockett.ai</string>
	</array>
</dict>
</plist>
